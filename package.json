{
  "name": "websocket-chat",
  "version": "1.0.0",
  "main": "server.js",
  "bin": {
    "server": "./server.js"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node server.js",
    "build": "echo 'Skipping pkg build on Railway. Run locally with: npm run build:local'",
    "build:local": "pkg server.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/server",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "WebSocket Chat Server",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "emoji-picker-react": "^3.5.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "ws": "^8.18.0"
  }
}
